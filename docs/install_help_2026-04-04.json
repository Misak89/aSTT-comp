  "scope": {
    "goal": "Complete onboarding for aSTT-comp app installation and STT model setup on Windows and macOS.",
    "platforms": [
      "windows",
      "macos"
    ]
  },
  "prerequisites": {
    "windows": [
      "git",
      "python>=3.13",
      "nodejs>=18",
      "ffmpeg"
    ],
    "macos": [
      "git",
      "python>=3.13",
      "nodejs>=18",
      "ffmpeg",
      "homebrew (recommended)"
    ]
  },
  "app_install": {
    "windows": [
      "git clone https://github.com/Misak89/aSTT-comp.git",
      "cd aSTT-comp",
      "py -3.13 -m venv .venv",
      ".venv\\Scripts\\pip install -r backend/requirements.txt",
      "npm --prefix frontend install",
      "npm --prefix frontend run build",
      "web-up.cmd"
    ],
    "macos": [
      "git clone https://github.com/Misak89/aSTT-comp.git",
      "cd aSTT-comp",
      "python3.13 -m venv .venv",
      ".venv/bin/pip install -r backend/requirements.txt",
      "npm --prefix frontend install",
      "npm --prefix frontend run build",
      "./web-up.sh"
    ]
  },
  "scripts": {
    "windows": "scripts/install_astt_windows.ps1",
    "macos": "scripts/install_astt_macos.sh",
    "features": [
      "prerequisite checks",
      "optional env/bootstrap steps",
      "whisper runtime setup",
      "download-size preview + download/skip per model",
      "optional VOSK and HF model flows"
    ]
  },
