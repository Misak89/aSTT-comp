  "lag_sweep": {
    "recommended_start_s": 10,
    "optional_fast_start_s": 5,
    "max_s": 60,
    "step_s": 5,
    "primary_metric": "max_visible_lag_s",
    "secondary_metric": "tail_lag_s"
  },
  "latency_metrics": {
    "segment_audio_s": "actual captured segment duration",
    "queue_wait_s": "time between segment close and model decode start",
    "decode_s": "model processing time",
    "tail_lag_s": "queue_wait_s + decode_s",
    "max_visible_lag_s": "segment_audio_s + queue_wait_s + decode_s",
    "over_budget_s": "max(0, max_visible_lag_s - lag_budget_s)"
  },
