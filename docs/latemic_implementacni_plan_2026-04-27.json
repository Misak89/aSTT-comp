  "route": "/benchmark/latemic",
  "mode": "late_mic",
  "main_goal": "Find the highest quality STT transcription from real microphone input with the smallest practical delayed-segment latency.",
  "constraints": {
    "input_source": "real_microphone",
    "not_live_stream": true,
    "not_simulation": true,
    "language_code_default": "cs",
    "audio_format": {
      "sample_rate_hz": 16000,
